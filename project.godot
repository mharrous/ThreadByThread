; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thread by Thread"
config/description="Simulador 3D cozy de organización de una mercería."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/version="0.4.0"
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

Events="*res://scripts/autoload/events.gd"
GameSettings="*res://scripts/autoload/game_settings.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="items"
3d_physics/layer_3="shelf_aim"
3d_physics/layer_4="player"
3d_physics/layer_5="settable"
3d_physics/layer_6="pick"

[rendering]

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2

[gui]

theme/custom_font="res://art/fonts/nunito_ui.tres"

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/interfaz.en.translation", "res://data/i18n/juego.en.translation")
locale/fallback="es"
